# CurriPulse AI — environment
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit real keys.

# ---------------------------------------------------------------------------
# Supabase — auth, Postgres, pgvector
# Project settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Institutional access control
# Comma-separated domain suffixes allowed to register. Empty = no restriction.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=.edu.in,.ac.in,.edu

# Used to build magic-link redirect URLs. Set to the deployed origin in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# NVIDIA NIM — primary generation + embeddings (OpenAI SDK compatible)
#
# These model IDs were measured against the live free endpoint, not assumed.
# meta/llama-3.3-70b-instruct is NOT usable there: 52s to first token on the
# first call, then HTTP 504 on the second. Measured alternatives:
#   mistralai/mistral-nemotron     4.1s total, 315ms TTFT   <- primary
#   meta/llama-3.1-8b-instruct     1.0s total, 338ms TTFT   <- fallback
# ---------------------------------------------------------------------------
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_CHAT_MODEL=mistralai/mistral-nemotron
NVIDIA_NIM_CHAT_MODEL_FALLBACK=meta/llama-3.1-8b-instruct

# nv-embedqa-e5-v5 is ASYMMETRIC: every request must carry input_type
# ("passage" for corpus documents, "query" for the syllabus text matched
# against them) or the API returns 400.
# Model and dimension are pinned together and must match the stored vectors.
# Changing either requires re-running scripts/seed-job-vectors.mjs.
NVIDIA_NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIM=1024

# ---------------------------------------------------------------------------
# Google Gemini — generation fallback ONLY.
# Deliberately not used for embeddings: Gemini embeddings are 768-dim and
# mixing dimensions in one vector space produces undefined cosine distance.
#
# gemini-1.5-flash is retired (404 on v1beta). gemini-3.5-flash-lite returned
# in 1.3s. Do NOT use the reasoning-tier flash models here: gemini-2.5-flash
# and gemini-3.6-flash spend maxOutputTokens on thinking and returned only
# ~15 usable tokens.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Neo4j AuraDB — skill knowledge graph
# ---------------------------------------------------------------------------
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---------------------------------------------------------------------------
# Job market data (optional live top-up over the seeded Kaggle corpus)
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
